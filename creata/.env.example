# Airflow Docker runtime
AIRFLOW_IMAGE_NAME=creata-airflow:3.2.2
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change_me_before_live_use
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me

# Local defaults
TZ=Asia/Taipei
CREATA_PROJECT_ROOT=/opt/airflow/project

# SQL Server connection used by report tasks
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER=192.168.0.253
SQL_PORT=1433
SQL_DATABASE=CHIComp06
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes

# MOMO daily sales report
MOMO_REPORT_CONFIG=/opt/airflow/project/configs/momo_daily_sales.example.json
MOMO_REPORT_DRY_RUN=true
MOMO_REPORT_USE_SAMPLE_DATA=false
MOMO_REPORT_DATE_OFFSET_DAYS=1
MOMO_REPORT_CHANNEL_FIELD=BA.Remark
MOMO_REPORT_CHANNEL_PATTERN=%MOMO%
MOMO_REPORT_RECIPIENTS=it@creata.com.tw,jason@creata.com.tw
MOMO_REPORT_OUTPUT_DIR=/opt/airflow/project/outputs/airflow/momo_daily_sales

# Microsoft Graph app-only mail delivery
EMAIL_PROVIDER=graph
GRAPH_TENANT_ID=your_tenant_id
GRAPH_CLIENT_ID=your_application_client_id
GRAPH_CLIENT_SECRET=your_client_secret_value
GRAPH_SENDER=it@creata.com.tw
